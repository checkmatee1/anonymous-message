<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.checkmate.message-reverse-ssh</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/ssh</string>
		<string>-N</string>
		<string>-T</string>
		<string>-o</string>
		<string>BatchMode=yes</string>
		<string>-o</string>
		<string>ExitOnForwardFailure=yes</string>
		<string>-o</string>
		<string>ServerAliveInterval=5</string>
		<string>-o</string>
		<string>ServerAliveCountMax=1</string>
		<string>-o</string>
		<string>ConnectTimeout=5</string>
		<string>-R</string>
		<string>127.0.0.1:23002:127.0.0.1:3002</string>
		<string>aliyun</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/com.checkmate.message-reverse-ssh.err.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/com.checkmate.message-reverse-ssh.out.log</string>
	<key>ThrottleInterval</key>
	<integer>3</integer>
</dict>
</plist>
